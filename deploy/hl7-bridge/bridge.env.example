# Copy to bridge.env and fill in. No secret goes in this file.
# Addresses allowed to send MLLP (the interface engine), comma-separated.
HL7_BRIDGE_MLLP_ALLOW=10.0.0.15
# Addresses allowed to pull over SFTP: MHAI's egress address (MHAI gives
# it to you), or the VPN range.
HL7_BRIDGE_SFTP_ALLOW=203.0.113.10
# The SFTP user name MHAI signs in as (MHAI gives it to you).
HL7_BRIDGE_SFTP_USER=mhai
# Close a batch file every minute (when it holds a message).
HL7_BRIDGE_ROTATE=1m
# Delete files MHAI has loaded after 7 days (at least 24h).
HL7_BRIDGE_RETAIN=168h
# Optional TLS for MLLP: certificate and key files mounted into the
# container, and a CA file to require client certificates (mutual TLS).
# HL7_BRIDGE_MLLP_TLS_CERT=/run/mhai/tls.crt
# HL7_BRIDGE_MLLP_TLS_KEY=/run/mhai/tls.key
# HL7_BRIDGE_MLLP_TLS_CLIENT_CA=/run/mhai/engine-ca.crt
