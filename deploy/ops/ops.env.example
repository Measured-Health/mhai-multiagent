# /etc/mhai-ops/ops.env (root, mode 600): settings for deploy/ops/. None of
# these is a secret; the secrets have their own files (below). install-ops.sh
# copies this example once and never overwrites it. KEY=VALUE, no quotes.

# The mhai-backend compose project.
MHAI_BACKEND_DIR=/srv/mhai-backend

# Backups: where, which public key, how many.
BACKUP_DIR=/var/backups/mhai
# The age public key(s), one per line (age1...). Never the private key:
# keep that in the password manager, off this host.
BACKUP_RECIPIENTS_FILE=/etc/mhai-ops/backup-recipients.txt
KEEP_DAILY=7
KEEP_WEEKLY=4

# Offsite copy (off unless this file exists and sets OFFSITE_BUCKET).
# Mode 600. Keys: OFFSITE_ENDPOINT (https://...), OFFSITE_BUCKET,
# OFFSITE_PREFIX (e.g. pilot/), OFFSITE_REGION, OFFSITE_ACCESS_KEY_ID,
# OFFSITE_SECRET_ACCESS_KEY, and optionally OFFSITE_PROVIDER (rclone's S3
# provider name, default Other).
OFFSITE_ENV_FILE=/etc/mhai-ops/offsite.env

# Alerts: one line, the webhook URL (Slack or Mattermost incoming webhook,
# an email relay, or https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>).
# Mode 600. No file: alerting is off (the checks still run and log).
ALERT_WEBHOOK_FILE=/etc/mhai-ops/alert-webhook-url
# The name alerts give this host.
HOST_LABEL=mhai-demo
ALERT_REPEAT_MINUTES=60

# Health check thresholds. CORE_HEALTH_URL empty turns that check off.
CORE_HEALTH_URL=http://127.0.0.1:8092/api/v1/readyz
DISK_MIN_FREE_PCT=15
BACKUP_MAX_AGE_HOURS=26
# 0 turns the restore-test reminder off (e.g. when it runs off this host).
RESTORE_MAX_AGE_DAYS=8
# Space-separated services to check; empty means postgres nats core, plus
# pipeline and egress-proxy when their profiles are on.
OPS_SERVICES=

# Images (the restore test's Postgres matches compose.yml's).
STATE_DIR=/var/lib/mhai-ops
CORE_IMAGE=ghcr.io/measured-health/mhai-multiagent-core:latest
RESTORE_POSTGRES_IMAGE=postgres:16.15-alpine
RCLONE_IMAGE=rclone/rclone:1.68.2
