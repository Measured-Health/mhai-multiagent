{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEval",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::@BUCKET@/eval/*"
      ]
    },
    {
      "Sid": "NeverWrite",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::@BUCKET@/*"
      ]
    },
    {
      "Sid": "NoModels",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::@BUCKET@/models/*"
      ]
    },
    {
      "Sid": "NothingUnderFixedNames",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::@BUCKET@/models/*/claim.json/*",
        "arn:aws:s3:::@BUCKET@/models/*/manifest.json/*",
        "arn:aws:s3:::@BUCKET@/models/*/manifest.sig/*",
        "arn:aws:s3:::@BUCKET@/models/*/signoff.json/*",
        "arn:aws:s3:::@BUCKET@/models/*/signoff.sig/*",
        "arn:aws:s3:::@BUCKET@/eval/*/testset.json/*",
        "arn:aws:s3:::@BUCKET@/eval/*/testset.sig/*"
      ]
    },
    {
      "Sid": "NeverDeleteOrUnlock",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention",
        "s3:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::@BUCKET@/*"
      ]
    },
    {
      "Sid": "NeverChangeTheBucket",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::@BUCKET@"
      ]
    }
  ]
}
