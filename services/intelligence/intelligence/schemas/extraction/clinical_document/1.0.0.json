{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mhai.extraction.clinical_document/1.0.0",
  "title": "mhai.extraction.clinical_document 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "patient",
    "encounter",
    "observations",
    "medications",
    "conditions",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "date",
        "facility_name",
        "language",
        "page_count"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/F_document_type"
        },
        "date": {
          "$ref": "#/$defs/F_date"
        },
        "facility_name": {
          "$ref": "#/$defs/F_string"
        },
        "language": {
          "$ref": "#/$defs/F_string"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "set by the pipeline"
        }
      }
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mrn",
        "other_ids",
        "family_name",
        "given_names",
        "date_of_birth",
        "sex"
      ],
      "properties": {
        "mrn": {
          "$ref": "#/$defs/F_string"
        },
        "other_ids": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "$ref": "#/$defs/F_other_id_kind"
              },
              "value": {
                "$ref": "#/$defs/F_string"
              }
            }
          }
        },
        "family_name": {
          "$ref": "#/$defs/F_string"
        },
        "given_names": {
          "$ref": "#/$defs/F_string"
        },
        "date_of_birth": {
          "$ref": "#/$defs/F_date"
        },
        "sex": {
          "$ref": "#/$defs/F_sex"
        }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end",
        "location_text",
        "clinician_text"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/F_encounter_kind"
        },
        "start": {
          "$ref": "#/$defs/F_datetime"
        },
        "end": {
          "$ref": "#/$defs/F_datetime"
        },
        "location_text": {
          "$ref": "#/$defs/F_string"
        },
        "clinician_text": {
          "$ref": "#/$defs/F_string"
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "name_text",
          "local_code",
          "value_text",
          "value_numeric",
          "comparator",
          "unit_text",
          "reference_text",
          "reference_low",
          "reference_high",
          "abnormal_flag",
          "specimen_text",
          "collected_at",
          "resulted_at"
        ],
        "properties": {
          "category": {
            "$ref": "#/$defs/F_observation_category"
          },
          "name_text": {
            "$ref": "#/$defs/F_string"
          },
          "local_code": {
            "$ref": "#/$defs/F_string"
          },
          "value_text": {
            "$ref": "#/$defs/F_string"
          },
          "value_numeric": {
            "$ref": "#/$defs/F_number"
          },
          "comparator": {
            "$ref": "#/$defs/F_comparator"
          },
          "unit_text": {
            "$ref": "#/$defs/F_string"
          },
          "reference_text": {
            "$ref": "#/$defs/F_string"
          },
          "reference_low": {
            "$ref": "#/$defs/F_number"
          },
          "reference_high": {
            "$ref": "#/$defs/F_number"
          },
          "abnormal_flag": {
            "$ref": "#/$defs/F_abnormal_flag"
          },
          "specimen_text": {
            "$ref": "#/$defs/F_string"
          },
          "collected_at": {
            "$ref": "#/$defs/F_datetime"
          },
          "resulted_at": {
            "$ref": "#/$defs/F_datetime"
          }
        }
      }
    },
    "medications": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_text",
          "strength_text",
          "dose_text",
          "route_text",
          "frequency_text",
          "start",
          "stop",
          "status"
        ],
        "properties": {
          "name_text": {
            "$ref": "#/$defs/F_string"
          },
          "strength_text": {
            "$ref": "#/$defs/F_string"
          },
          "dose_text": {
            "$ref": "#/$defs/F_string"
          },
          "route_text": {
            "$ref": "#/$defs/F_string"
          },
          "frequency_text": {
            "$ref": "#/$defs/F_string"
          },
          "start": {
            "$ref": "#/$defs/F_date"
          },
          "stop": {
            "$ref": "#/$defs/F_date"
          },
          "status": {
            "$ref": "#/$defs/F_medication_status"
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "local_code",
          "local_system",
          "clinical_status",
          "verification",
          "onset"
        ],
        "properties": {
          "text": {
            "$ref": "#/$defs/F_string"
          },
          "local_code": {
            "$ref": "#/$defs/F_string"
          },
          "local_system": {
            "$ref": "#/$defs/F_local_system"
          },
          "clinical_status": {
            "$ref": "#/$defs/F_clinical_status"
          },
          "verification": {
            "$ref": "#/$defs/F_verification"
          },
          "onset": {
            "$ref": "#/$defs/F_date"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "text"
        ],
        "properties": {
          "heading": {
            "$ref": "#/$defs/F_string"
          },
          "text": {
            "$ref": "#/$defs/F_note_text"
          }
        }
      }
    }
  },
  "$defs": {
    "F_string": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "raw_text",
        "page",
        "bbox",
        "confidence",
        "band",
        "grounded",
        "flags"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "text as read; null if not present"
        },
        "raw_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "exact text on the page"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "x0, y0, x1, y1 as fractions of the page"
        },
        "script": {
          "enum": [
            "printed",
            "handwritten",
            "mixed",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "set by the pipeline"
        },
        "band": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "set by the pipeline"
        },
        "grounded": {
          "type": "boolean",
          "description": "set by the pipeline (section 4.5)"
        },
        "flags": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ungrounded",
              "out_of_range",
              "implausible",
              "unit_unknown",
              "code_unmapped",
              "date_invalid",
              "conflict",
              "suspicious_text",
              "illegible"
            ]
          },
          "description": "set by the pipeline"
        }
      }
    },
