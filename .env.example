# MHAI Environment Variables — copy to .env, never commit real secrets.
APP_ENV=local
LOG_LEVEL=INFO

# Compose stack (docker-compose.yml). Ports bind to 127.0.0.1 only.
POSTGRES_DB=mhai
POSTGRES_USER=mhai
POSTGRES_PASSWORD=change-me
TORCH=cpu                      # PyTorch build for the intelligence image: cpu or cu128
# Host ports, if the defaults clash:
# POSTGRES_PORT=5432  REDIS_PORT=6379  OLLAMA_PORT=11434  API_PORT=8000  CORE_PORT=8080
# OTEL_GRPC_PORT=4317  OTEL_HTTP_PORT=4318

# Database (compose sets this from the POSTGRES_* values above)
DATABASE_URL=postgresql+psycopg://mhai:change-me@postgres:5432/mhai

# NATS (compose service `nats`): one user per service. Dev passwords and
# the JetStream key: letters and digits only, starting with a letter
# (e.g. `echo k$(openssl rand -hex 32)`). These placeholders are rejected
# at startup (compose and the core service): replace each with its own
# value, using the same gateway password in NATS_URL. Each service gets
# only its own password; the nats service gets them all.
# Production uses NKeys and TLS: set NATS_NKEY_SEED_PATH and NATS_TLS_*
# (see services/nats/README.md).
NATS_GATEWAY_PASSWORD=changemeReplaceWithLettersAndDigits
NATS_PIPELINE_PASSWORD=changemeReplaceWithLettersAndDigits
NATS_ECHO_PASSWORD=changemeReplaceWithLettersAndDigits
NATS_BFF_CLINICAL_PASSWORD=changemeReplaceWithLettersAndDigits
NATS_BFF_PLATFORM_PASSWORD=changemeReplaceWithLettersAndDigits
# NATS_JS_KEY encrypts JetStream at rest; losing it loses the store.
NATS_JS_KEY=changemeReplaceWithALetterThen64HexDigits
NATS_URL=nats://gateway:changemeReplaceWithLettersAndDigits@nats:4222
# NATS_NKEY_SEED_PATH=/run/secrets/nats-gateway.seed
# NATS_TLS_CA_PATH=/run/secrets/nats-ca.pem          # required outside development,
# NATS_TLS_CERT_PATH=/run/secrets/nats-core.pem      # all three together
# NATS_TLS_KEY_PATH=/run/secrets/nats-core-key.pem
# NATS_JS_REPLICAS=1                   # JOBS, DEAD and KV replicas: 3 (R3) on the production cluster
# JOBS_PIPELINE_MAX_ACK_PENDING=8      # pipeline worker count x concurrency

# Core service (Go, compose services core-migrate, core, core-cli). Every
# value below is a placeholder that the core service or its migrate step
# rejects: replace each before `make up`. Database passwords: letters and
# digits, at least 16 characters (they go into a URL). Keys: at least 32
# random bytes, e.g. `openssl rand -hex 32`.
CORE_DB_USER=core_app                    # login, member of mhai_app only
CORE_DB_PASSWORD=changemeReplaceWithLettersAndDigits
PROVISION_DB_USER=core_provision         # seed CLI login, member of mhai_provision only
PROVISION_DB_PASSWORD=changemeReplaceWithLettersAndDigits
MFA_ENCRYPTION_KEY=changeme-replace-with-32-or-more-random-bytes
BFF_SERVICE_KEYS=changeme-replace-with-32-or-more-random-bytes   # comma-separated, one per BFF
# CORE_ENV=development  CORE_PORT=8080

# Redis
REDIS_URL=redis://redis:6379/0

# Queue
QUEUE_BACKEND=redis
QUEUE_URL=mhai.queries
QUEUE_DLQ_URL=mhai.queries.dlq
QUEUE_WORKERS=3

# Secrets (change in prod)
HF_TOKEN=changeme
FERNET_KEY=changeme
JWT_SECRET=changeme
JWT_ALGO=HS256
JWT_EXP_HOURS=24

# Models
NLI_MODEL=cross-encoder/nli-deberta-v3-base
# CCA LLM: "ollama" (the compose service) or "transformers" (CCA_MODEL in-process)
CCA_BACKEND=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m
CCA_MODEL=Qwen/Qwen2.5-7B-Instruct
DENSE_MODEL=all-MiniLM-L6-v2
DIA_MODEL=microsoft/swinv2-base-patch4-window8-256

# Rate limits
QWEN_RPM=15
QWEN_TPM=30000
DEBERTA_RPM=120

# Guardrail thresholds
TRUST_PASS_DEFAULT=0.55
TRUST_REGEN_FLOOR=0.30
SE_THRESHOLD_RAG=0.8
SE_K_SAMPLES=5
PERSONA_ETA=0.05
CMA_ES_MIN_CORRECTIONS=50

# Agent URLs (for a future split into per-agent services; unused today,
# all agents run in-process)
DIA_URL=http://dia_agent:8010
QDA_URL=http://qda_agent:8011
CCA_URL=http://cca_agent:8012
HGA_URL=http://hga_agent:8013
ORCH_URL=http://orchestrator_agent:8015

AGENT_HTTP_TIMEOUT=300
AGENT_HTTP_RETRIES=2

# Storage
S3_BUCKET=mhai-artifacts-dev

# Observability
# (start the collector with `make up-observability`)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
